{
  "name": "sfb16_prep",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "forwardPorts": [8787],
  "portsAttributes": {
    "8787": {
      "label": "RStudio Server",
      "onAutoForward": "openBrowser"
    }
  },
  "postStartCommand": "sudo rstudio-server start",
  "postCreateCommand": "R -e \"renv::restore(prompt = FALSE); renv::install('plotly'); renv::snapshot(prompt = FALSE)\"",
  "customizations": {
    "vscode": {
      "extensions": [
        "quarto.quarto",
        "reditorsupport.r"
      ]
    }
  }
}
