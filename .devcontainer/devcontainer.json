{
  "name": "sfb16_prep",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [8787],
  "portsAttributes": {
    "8787": {
      "label": "RStudio Server",
      "onAutoForward": "openBrowser"
    }
  },
  "postStartCommand": "sudo rstudio-server start",
  "remoteEnv": {
    "DISABLE_AUTH": "true"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "quarto.quarto",
        "reditorsupport.r"
      ]
    }
  }
}
